{
    "name": "innmind/html",
    "type": "library",
    "description": "Library to abstract html manipulation",
    "keywords": [
        "html"
    ],
    "homepage": "http://github.com/Innmind/Html",
    "license": "MIT",
    "authors": [
        {
            "name": "Baptiste Langlade",
            "email": "baptiste.langlade@hey.com"
        }
    ],
    "support": {
        "issues": "http://github.com/Innmind/Html/issues"
    },
    "require": {
        "php": "~8.5",
        "innmind/xml": "~9.0",
        "innmind/filesystem": "~9.0",
        "innmind/immutable": "~6.0",
        "innmind/validation": "~3.0",
        "innmind/url": "~5.0"
    },
    "autoload": {
        "psr-4": {
            "Innmind\\Html\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Innmind\\Html\\": "tests/"
        }
    },
    "require-dev": {
        "innmind/black-box": "^6.4.1",
        "innmind/static-analysis": "~1.3",
        "innmind/coding-standard": "~2.0"
    }
}
